{
  "name": "bacalhau-website",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "docusaurus": "docusaurus",
    "start": "docusaurus start",
    "build": "npm run generate:llms && docusaurus build && node scripts/add-sitemap-lastmod.mjs && node scripts/copy-legacy-machine-routes.mjs && node scripts/generate-social-cards.mjs",
    "deploy": "docusaurus deploy",
    "swizzle": "docusaurus swizzle",
    "clear": "docusaurus clear",
    "serve": "docusaurus serve",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids",
    "typecheck": "tsc",
    "spell-check": "cspell lint --quiet --unique --gitignore-root . \"**/*.{md,mdx,ts,tsx,js,jsx,mjs,cjs,json}\"",
    "generate:llms": "node scripts/generate-llms.mjs",
    "validate:site": "node scripts/validate-site.mjs",
    "test:analytics": "node --test src/analytics/*.test.mjs",
    "test:image-metadata": "node --test tooling/image-metadata-adapter/*.test.mjs"
  },
  "dependencies": {
    "@docusaurus/core": "^3.10.2",
    "@docusaurus/plugin-client-redirects": "^3.10.2",
    "@docusaurus/plugin-content-docs": "^3.10.2",
    "@docusaurus/plugin-google-tag-manager": "^3.10.2",
    "@docusaurus/preset-classic": "^3.10.2",
    "@mdx-js/react": "^3.1.1",
    "clsx": "^2.1.1",
    "image-size": "file:./tooling/image-metadata-adapter",
    "lottie-web": "^5.13.0",
    "posthog-js": "1.428.7",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "^3.10.2",
    "@docusaurus/tsconfig": "^3.10.2",
    "@docusaurus/types": "^3.10.2",
    "@resvg/resvg-js": "2.6.2",
    "cspell": "^8.6.0",
    "jsdom": "27.4.0",
    "typescript": "~5.8.3"
  },
  "overrides": {
    "serialize-javascript": "7.0.7",
    "uuid": "11.1.1",
    "qs": "6.16.0",
    "image-size": "$image-size"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  },
  "allowScripts": {
    "core-js@3.50.0": true,
    "fsevents@2.3.3": true
  },
  "workspaces": [
    "tooling/image-metadata-adapter"
  ]
}
